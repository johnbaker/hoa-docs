{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/instrument-document.schema.json",
  "title": "InstrumentDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrument"],
  "properties": {
    "instrument": { "$ref": "#/$defs/Instrument" },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/Operation" } },
    "incorporations": { "type": "array", "items": { "$ref": "#/$defs/Incorporation" } },
    "content": { "$ref": "#/$defs/ContentTree" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "instrument": {
            "properties": {
              "availability": {
                "properties": { "has_text": { "const": true } },
                "required": ["has_text"]
              }
            },
            "required": ["availability"]
          }
        }
      },
      "then": { "required": ["content"] }
    }
  ],
  "$defs": {
    "Instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "base_doc_id", "title", "instrument_kind", "doc_type", "availability"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" },
        "base_doc_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "title": { "type": "string", "minLength": 1 },
        "short_title": { "type": "string" },
        "instrument_kind": {
          "type": "string",
          "enum": ["declaration", "amendment", "restatement", "annexation", "assignment", "bylaws", "exhibit", "policy", "resolution", "other"]
        },
        "doc_type": { "type": "string", "minLength": 1 },
        "jurisdiction": { "type": "string", "minLength": 2, "maxLength": 32 },
        "sort_key": { "type": "string", "minLength": 1 },
        "authority_tier": { "type": "integer", "minimum": 0, "maximum": 100 },
        "recorded_at": { "type": "string", "format": "date" },
        "effective_at": { "type": "string", "format": "date" },
        "expires_at": { "type": "string", "format": "date" },
        "recording": { "$ref": "#/$defs/RecordingInfo" },
        "format": { "type": "string", "enum": ["json", "markdown", "pdf_text", "html", "other"] },
        "source": { "$ref": "#/$defs/SourceInfo" },
        "availability": { "$ref": "#/$defs/Availability" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "coverage": { "type": "array", "items": { "$ref": "#/$defs/CoverageEntry" } },
        "declarant_history": { "type": "array", "items": { "$ref": "#/$defs/DeclarantEntry" } },
        "current_declarant": { "$ref": "#/$defs/DeclarantEntry" },
        "notes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },

    "Availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_text", "reason"],
      "properties": {
        "has_text": { "type": "boolean" },
        "reason": {
          "type": "string",
          "enum": ["available", "not_in_corpus", "redacted", "not_digitized", "pending_import", "copyright_restricted", "unknown"]
        },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "requested_from": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "notes": { "type": "string" }
      }
    },

    "Incorporation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "exhibit_label", "included_in_instrument_id"],
      "properties": {
        "role": { "type": "string", "enum": ["exhibit", "attachment", "incorporated_by_reference", "schedule", "other"] },
        "exhibit_label": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "instrument_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" },
        "base_doc_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "included_in_instrument_id": { "type": "string", "minLength": 1 },
        "effective_from": { "type": "string", "format": "date" },
        "effective_to": { "type": "string", "format": "date" },
        "availability_hint": { "type": "string", "enum": ["available", "missing_text", "unknown"] },
        "notes": { "type": "string" }
      },
      "anyOf": [
        { "required": ["instrument_id"] },
        { "required": ["base_doc_id"] }
      ]
    },

    "RecordingInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "county": { "type": "string" },
        "state": { "type": "string", "minLength": 2, "maxLength": 32 },
        "book": { "type": ["string", "null"] },
        "page": { "type": ["string", "null"] },
        "instrument_number": { "type": ["string", "null"] },
        "plat_book": { "type": ["string", "null"] },
        "plat_page": { "type": ["string", "null"] }
      }
    },

    "CoverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "source_instrument_id"],
      "properties": {
        "action": { "type": "string", "enum": ["annex_property", "deannex_property", "other"] },
        "scope_kind": { "type": "string", "enum": ["all_lots", "some_lots", "common_area_only", "declarant_rights", "unknown"] },
        "phases": { "type": "array", "items": { "type": "string" } },
        "phase_scope": { "type": "string", "enum": ["full_phase", "partial_phase", "unknown"] },
        "plat_refs": { "type": "array", "items": { "$ref": "#/$defs/PlatRef" } },
        "parcel_ids": { "type": "array", "items": { "type": "string" } },
        "lot_ids": { "type": "array", "items": { "type": "string" } },
        "lot_refs": { "type": "array", "items": { "$ref": "#/$defs/LotRef" } },
        "legal_description": { "type": "string" },
        "source_instrument_id": { "type": "string", "minLength": 1 },
        "effective_at": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    },

    "PlatRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book", "page"],
      "properties": {
        "book": { "type": "string" },
        "page": { "type": "string" }
      }
    },

    "LotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "lot"],
      "properties": {
        "phase": { "type": "string" },
        "lot": { "type": "string" }
      }
    },

    "DeclarantEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_instrument_id"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "source_instrument_id": { "type": "string", "minLength": 1 },
        "effective_at": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    },

    "SourceInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_type": { "type": "string", "enum": ["born_digital", "transcribed", "ocr", "converted", "imported", "unknown"] },
        "source_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "path": { "type": "string" },
        "sha": { "type": "string" },
        "notes": { "type": "string" }
      }
    },

    "ContentTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "root_ref", "nodes"],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "root_ref": { "type": "string", "minLength": 1 },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Node" } },
        "meta": { "$ref": "#/$defs/ContentMeta" }
      }
    },

    "ContentMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "tombstones": { "type": "array", "items": { "$ref": "#/$defs/Tombstone" } }
      }
    },

    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,255}$" },
        "type": {
          "type": "string",
          "enum": ["document", "article", "section", "subsection", "paragraph", "definition", "exhibit", "table", "list", "list_item", "heading", "text"]
        },
        "label": { "type": "string" },
        "num": { "oneOf": [{ "type": "integer" }, { "type": "number" }, { "type": "string", "minLength": 1 }] },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "children": { "type": "array", "items": { "$ref": "#/$defs/NodeRef" } },
        "meta": { "$ref": "#/$defs/NodeMeta" }
      }
    },

    "NodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": { "ref": { "type": "string", "minLength": 1 } }
    },

    "NodeMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor": { "type": "string" },

        "render_hint": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional hints for Reading View rendering (not for legal meaning).",
          "properties": {
            "style": {
              "type": "string",
              "enum": ["default", "hanging_label", "blockquote", "compact"],
              "description": "Basic rendering style hint."
            },
            "preserve_linebreaks": {
              "type": "boolean",
              "description": "If true, renderer should preserve explicit newline characters in text."
            }
          }
        },

        "indent_level": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional indentation level for display when source uses nested indentation."
        },

        "pdf_dest": { "$ref": "#/$defs/PdfDest" },

        "pdf_refs": {
          "type": "array",
          "description": "Optional mapping to locations in the source PDF for facsimile jump/highlight.",
          "items": { "$ref": "#/$defs/PdfRef" }
        },

        "citations": { "type": "array", "items": { "$ref": "#/$defs/Citation" } },
        "source_ranges": { "type": "array", "items": { "$ref": "#/$defs/SourceRange" } },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "note": {
          "type": "string",
          "description": "Non-substantive note about why this node exists or how it was derived."
        },

        "transcription": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional transcription notes (e.g., OCR artifacts) without changing the canonical text.",
          "properties": {
            "fidelity": { "type": "string", "enum": ["verbatim", "normalized"] },
            "has_ocr_artifacts": { "type": "boolean" },
            "note": { "type": "string" }
          }
        },

        "exhibit_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instrument_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" },
            "base_doc_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
          },
          "anyOf": [
            { "required": ["instrument_id"] },
            { "required": ["base_doc_id"] }
          ]
        },

        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    
    "PdfDest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
            "name": {
            "type": "string",
            "minLength": 1,
            "description": "Named destination identifier in the PDF used for navigation in pdf.js."
            },
            "doc_id": {
            "type": "string",
            "description": "Optional identifier if multiple PDFs exist for an instrument."
            },
            "kind": {
            "type": "string",
            "enum": ["named_dest", "outline_item", "explicit"],
            "description": "How this destination is defined in the PDF."
            },
            "note": { "type": "string" }
        }
    },

    "PdfRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page"],
      "properties": {
        "doc_id": { "type": "string", "description": "Optional identifier if multiple PDFs exist for an instrument." },
        "page": { "type": "integer", "minimum": 1, "description": "1-based page number." },
        "rect": {
          "type": "array",
          "description": "Optional bounding box [x1,y1,x2,y2] in the specified coord system.",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "coord_system": {
          "type": "string",
          "enum": ["pdf_points", "viewport", "unknown"],
          "description": "Coordinate system for rect. Prefer pdf_points."
        },
        "note": { "type": "string" }
      }
    },

    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": { "label": { "type": "string" }, "instrument_id": { "type": "string" }, "node_id": { "type": "string" } }
    },

    "SourceRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_start": { "type": "integer", "minimum": 0 },
        "page_end": { "type": "integer", "minimum": 0 },
        "line_start": { "type": "integer", "minimum": 0 },
        "line_end": { "type": "integer", "minimum": 0 },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 0 }
      }
    },

    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "node_id"],
      "properties": {
        "instrument_id": { "type": "string", "minLength": 1 },
        "node_id": { "type": "string", "minLength": 1 },
        "pdf_dest": { "$ref": "#/$defs/PdfDest" },
        "note": { "type": "string" }
      }
    },

    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_by_instrument_id": { "type": "string" },
        "created_by_op_id": { "type": "string" },
        "modified_by_instrument_id": { "type": "string" },
        "modified_by_op_id": { "type": "string" },
        "replaces_node_id": { "type": "string" },
        "source_ref": { "$ref": "#/$defs/SourceRef" }
      }
    },

    "Tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "deleted_by_instrument_id", "deleted_by_op_id"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "parent_node_id": { "type": "string" },
        "position": {
          "type": "string",
          "enum": ["start", "end", "after", "before", "only_child", "unknown"]
        },
        "before_child_node_id": { "type": "string" },
        "after_child_node_id": { "type": "string" },
        "deleted_by_instrument_id": { "type": "string" },
        "deleted_by_op_id": { "type": "string" },
        "last_seen_version_id": { "type": "string" },
        "source_ref": { "$ref": "#/$defs/SourceRef" },
        "cached": { "$ref": "#/$defs/TombstoneCached" }
      }
    },

    "TombstoneCached": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "label": { "type": "string" },
        "title": { "type": "string" },
        "text_snippet": { "type": "string" }
      }
    },

    "TargetSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "value"],
      "properties": {
        "by": { "type": "string", "enum": ["node_id", "heading_text", "section_path"] },
        "value": { "type": "string", "minLength": 1 },
        "occurrence": { "type": "integer", "minimum": 1 }
      }
    },

    "TextPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["insert_before", "insert_after", "replace_range", "delete_range"]
        },
        "anchor_text": { "type": "string" },
        "match_text": { "type": "string" },
        "occurrence": { "type": "integer", "minimum": 1 },
        "insert_text": { "type": "string" }
      }
    },

    "NodeFieldUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "label": { "type": "string" }
      }
    },

    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op_id", "op_type"],
      "properties": {
        "op_id": { "type": "string", "minLength": 1 },
        "op_type": {
          "type": "string",
          "enum": [
            "replace_node",
            "replace_children",
            "replace_entire_document",
            "insert_children",
            "delete_node",
            "delete_children",
            "patch_text",
            "update_node_fields",
            "update_incorporation",
            "assign_declarant_rights",
            "annex_property",
            "deannex_property",
            "other"
          ]
        },
        "target_base_doc_id": { "type": "string" },
        "target_node_id": { "type": "string" },
        "target_selector": { "$ref": "#/$defs/TargetSelector" },
        "position": { "type": "string", "enum": ["before", "after", "start", "end"] },
        "before_child_node_id": { "type": "string" },
        "after_child_node_id": { "type": "string" },
        "pdf_dest": { "$ref": "#/$defs/PdfDest" },
        "source_ref": { "$ref": "#/$defs/SourceRef" },
        "payload_nodes": { "type": "array", "items": { "$ref": "#/$defs/Node" } },
        "payload_instrument_id": { "type": "string" },
        "text_patches": { "type": "array", "items": { "$ref": "#/$defs/TextPatch" } },
        "update_fields": { "$ref": "#/$defs/NodeFieldUpdate" },
        "incorporation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exhibit_label": { "type": "string" },
            "previous_incorporated_base_doc_id": { "type": "string" },
            "previous_payload_instrument_id": { "type": "string" },
            "new_incorporated_base_doc_id": { "type": "string" },
            "new_payload_instrument_id": { "type": "string" }
          }
        },
        "parties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grantor": { "type": "string" },
            "grantee": { "type": "string" },
            "assignor": { "type": "string" },
            "assignee": { "type": "string" }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope_kind": { "type": "string", "enum": ["all_lots", "some_lots", "common_area_only", "declarant_rights", "unknown"] },
            "phases": { "type": "array", "items": { "type": "string" } },
            "phase_scope": { "type": "string", "enum": ["full_phase", "partial_phase", "unknown"] },
            "plat_refs": { "type": "array", "items": { "$ref": "#/$defs/PlatRef" } },
            "parcel_ids": { "type": "array", "items": { "type": "string" } },
            "lot_ids": { "type": "array", "items": { "type": "string" } },
            "legal_description": { "type": "string" }
          }
        },
        "effective_at": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    }
  }
}
